{
  "expo": {
    "name": "UnivAgenda",
    "slug": "UnivAgenda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logo-app.png",
    "scheme": "univagenda",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/logo-app.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F4B84",
        "foregroundImage": "./assets/branding/logo-app.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/branding/logo-app.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F4B84",
          "image": "./assets/branding/logo-splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
